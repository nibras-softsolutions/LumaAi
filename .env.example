# Database configuration (defaults to local SQLite if unset)
# DATABASE_URL="sqlite+aiosqlite:///./luma_auth.db"
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AI Provider: "ollama" (default) or "openai" / "groq" / "openrouter"
AI_PROVIDER="ollama"

# Option 1: Ollama Model Backend (Local or Remote)
OLLAMA_MODEL="llama3.2"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_API_KEY="optional-bearer-token-for-secured-ollama"

# Option 2: Hosted Model API (e.g., Groq, OpenRouter, OpenAI)
# AI_PROVIDER="groq"
# GROQ_API_KEY="gsk_..."
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_MODEL="openai/gpt-oss-120b"


# Cookie Security (set to true in production HTTPS)
COOKIE_SECURE="false"
# Cookie SameSite policy: "lax" (recommended with Vercel rewrites or same-origin) or "none" (for cross-domain with COOKIE_SECURE=true)
COOKIE_SAMESITE="lax"

# Allowed Cross-Origin Origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:8000,http://localhost:8000"

